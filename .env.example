# Public hostname. Do not include https:// or a trailing slash.
DOMAIN=api.example.com
TZ=Asia/Shanghai

# Pinned application images. Upgrade these through scripts/update.sh.
NEW_API_VERSION=v1.0.0-rc.38
CPA_VERSION=v7.3.7
POSTGRES_VERSION=17.11-alpine
REDIS_VERSION=7.4.11-alpine
NGINX_VERSION=1.30.5-alpine

# Database and cache. scripts/setup.sh replaces every CHANGE_ME value.
POSTGRES_DB=newapi
POSTGRES_USER=newapi
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# New API application secrets.
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
CRYPTO_SECRET=CHANGE_ME_CRYPTO_SECRET

# CLIProxyAPI secrets. The setup script also renders them into cpa/config.yaml.
CPA_API_KEY=CHANGE_ME_CPA_API_KEY
CPA_MANAGEMENT_KEY=CHANGE_ME_CPA_MANAGEMENT_KEY
CPA_LOCAL_PORT=8317

# Local backup policy.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
